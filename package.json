{
  "name": "code-stream-overlay",
  "version": "0.1.2",
  "description": "Live, repo-aware overlays for OBS: git, tests, goals, timer and coding-agent activity.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PavlikPolivka/code-stream-overlay.git"
  },
  "homepage": "https://github.com/PavlikPolivka/code-stream-overlay#readme",
  "bugs": {
    "url": "https://github.com/PavlikPolivka/code-stream-overlay/issues"
  },
  "type": "module",
  "bin": {
    "code-stream-overlay": "dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "version": "node scripts/sync-version.mjs && git add src/constants.ts",
    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "fast-xml-parser": "^5.2.5",
    "tinyglobby": "^0.2.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "obs",
    "overlay",
    "streaming",
    "twitch",
    "youtube",
    "claude-code",
    "git",
    "tests",
    "developer-tools"
  ]
}
